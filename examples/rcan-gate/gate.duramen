    | {"now": 1000, "maxSpeed": 1, "limits": {"base": {"min": -1, "max": 1}}} | {"id": "m1", "timestamp": 1000, "role": "CREATOR", "kind": "move", "scope": "safety", "targets": [{"joint": "base", "position": 0}], "speed": 0} | "execute" | "ok" |
